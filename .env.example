# Copy to .env and fill in. .env is gitignored.

# Google Gemini — https://aistudio.google.com/apikey
# Free tier: ~15 req/min, 1500 req/day. This is a real constraint for the RAGAS
# evaluation matrix; see eval/README.md.
GEMINI_API_KEY=

# Qdrant Cloud — https://cloud.qdrant.io
QDRANT_ENDPOINT=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=

# --- Optional overrides (defaults live in src/rag/config.py) ---
# EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base
# RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base
# COLLECTION_PREFIX=flowers
# CRAWL_BASE_URL=https://hoatuoimymy.com
#
# Pinned on purpose — do not set this to an alias like "gemini-flash-latest".
# An alias changes model underneath you and makes committed eval numbers
# irreproducible. (gemini-2.0-flash, used by the original code, is retired.)
# GEMINI_MODEL=gemini-2.5-flash

# --- Deprecated ---
# The original code read a misspelled variable name. config.py still falls back
# to it so the deployed Streamlit Cloud secrets keep working. Prefer
# GEMINI_API_KEY above for new setups.
# GENMINI_KEY=
